{
  "manifest_version": 3,
  "name": "Vitta CRM Reminder",
  "version": "0.5.0",
  "description": "Agrupa tarefas do Nave CRM e mostra lembretes no horário.",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "https://crm.nave.app.br/*",
    "https://crm-server.nave.app.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Vitta CRM Reminder",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://crm.nave.app.br/*"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://crm.nave.app.br/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icon32.png",
        "icon48.png"
      ],
      "matches": [
        "https://crm.nave.app.br/*"
      ]
    }
  ]
}